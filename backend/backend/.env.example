# Configure this value as an environment variable or with .NET User Secrets.
# Do not put a real password in this file or commit a real .env file.
ConnectionStrings__local=Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<database>;Persist Security Info=False;User ID=<user>;Password=<password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
